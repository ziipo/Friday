# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# uv
# (uv.lock IS committed; cache is not)
.uv-cache/

# Local config — credentials, channel allowlists, folder IDs
scripts/config/*.local.yaml
scripts/config/*.local.yml
scripts/config/*.local.json

# Runtime state
EngagementLog/
.logs/
*.log

# ArchiveBox working dir (large; archives are committed via LFS in Archive/)
archivebox-data/

# Inbox is a working folder, not version-controlled content
Inbox/

# Review queue is ephemeral until approved
ReviewQueue/pending/

# OS / editor noise
.DS_Store
.idea/
.vscode/
*.swp

# Trust + reputation state files (regenerated by Janitor)
Institutional-Memory/.reputation.json
Institutional-Memory/.trust-stats.json
