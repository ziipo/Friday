<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.friday.trust_ratchet</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kenburleson/.local/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/kenburleson/Projects/Friday</string>
        <string>python</string>
        <string>-m</string>
        <string>trust_ratchet.apply</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/kenburleson/Projects/Friday/scripts</string>
        <key>FRIDAY_ROOT</key>
        <string>/Users/kenburleson/Projects/Friday</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/Users/kenburleson/.local/bin:/usr/bin:/bin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/kenburleson/Projects/Friday</string>

    <!-- Sunday 03:30 local — runs after weekly sweep (03:00) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/kenburleson/Projects/Friday/.logs/trust_ratchet.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kenburleson/Projects/Friday/.logs/trust_ratchet.stderr.log</string>
</dict>
</plist>
