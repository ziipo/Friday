<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.friday.scribe</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kenburleson/.local/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/kenburleson/Projects/Friday</string>
        <string>python</string>
        <string>-m</string>
        <string>scribe.watcher</string>
